<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка чуть «вдавливается» при нажатии. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="90" android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType" />
            <objectAnimator android:duration="90" android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType" />
            <objectAnimator android:duration="90" android:propertyName="translationZ" android:valueTo="-4dp" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="120" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="translationZ" android:valueTo="0dp" android:valueType="floatType" />
        </set>
    </item>
</selector>
