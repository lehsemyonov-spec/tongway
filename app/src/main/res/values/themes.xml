<resources>
    <style name="Theme.Tongway" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/text</item>
        <item name="colorSecondary">@color/accent_light</item>
        <item name="colorSurface">#111111</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:textColorHighlight">#66EA5F0A</item>
    </style>

    <!-- Заголовки шрифтом Unbounded, как на слайдах. -->
    <style name="Tongway.Title" parent="">
        <item name="android:fontFamily">@font/unbounded</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Tongway.H2" parent="Tongway.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Tongway.CardTitle" parent="Tongway.Title">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Tongway.StepNumber" parent="Tongway.Title">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Tongway.Body" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Tongway.Hint" parent="Tongway.Body">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Tongway.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Tongway.Chip" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <!-- Кнопки-пилюли. -->
    <style name="Tongway.Pill" parent="">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="Tongway.Pill.Outline" parent="Tongway.Pill">
        <item name="android:background">@drawable/bg_pill_outline</item>
    </style>

    <style name="Tongway.PillSmall" parent="Tongway.Pill">
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:layout_marginTop">0dp</item>
    </style>

    <style name="Tongway.PillSmall.Outline" parent="Tongway.PillSmall">
        <item name="android:background">@drawable/bg_pill_outline</item>
    </style>
</resources>
