<?xml version="1.0" encoding="utf-8"?>
<!-- Сеанс Live в истории: метка, итоги, первые фразы и «Открыть сеанс». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_live"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Tongway.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_ok"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/live_label"
            android:textColor="@color/accent_light"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/liveItemTitle"
            style="@style/Tongway.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/liveItemStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/accent_light"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/liveItemPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="3"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        style="@style/Tongway.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="@string/live_open_session"
        android:textColor="@color/accent"
        android:textSize="12sp" />
</LinearLayout>
