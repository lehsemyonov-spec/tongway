<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp">

        <!-- Верхняя строка, как на слайдах: «бургер», переключатель, номер версии. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="22dp"
                android:layout_height="16dp"
                android:clickable="true"
                android:contentDescription="@string/settings_title"
                android:focusable="true"
                android:src="@drawable/deco_burger" />

            <ImageView
                android:id="@+id/btnExit"
                android:layout_width="36dp"
                android:layout_height="18dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/exit_yes"
                android:focusable="true"
                android:src="@drawable/deco_toggle" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/versionText"
                style="@style/Tongway.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/Tongway.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/app_name"
            android:textSize="40sp" />

        <TextView
            style="@style/Tongway.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_accent"
            android:textColor="@color/accent"
            android:textSize="40sp" />

        <TextView
            style="@style/Tongway.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/subtitle" />

        <!-- Робот из презентации и вращающаяся механическая ДНК. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="62"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/robot_hero" />

            <com.tongway.translator.ui.MechanicalDnaView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="38" />
        </LinearLayout>

        <!-- Главная кнопка: объёмная, со значком и тенью — чтобы было видно, что это кнопка. -->
        <TextView
            android:id="@+id/btnBubble"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_main"
            android:clickable="true"
            android:drawableStart="@drawable/ic_translate"
            android:drawablePadding="12dp"
            android:elevation="10dp"
            android:focusable="true"
            android:fontFamily="@font/unbounded"
            android:gravity="center"
            android:outlineAmbientShadowColor="@color/accent"
            android:outlineSpotShadowColor="@color/accent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:stateListAnimator="@animator/press_scale"
            android:text="@string/bubble_show"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnHowTo"
            style="@style/Tongway.Pill.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/how_to" />

        <TextView
            style="@style/Tongway.H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title" />

        <!-- 01. Словарь -->
        <LinearLayout
            style="@style/Tongway.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Tongway.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/step_model_title" />

                <TextView
                    style="@style/Tongway.StepNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01" />
            </LinearLayout>

            <TextView
                style="@style/Tongway.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_model_hint" />

            <TextView
                android:id="@+id/modelChip"
                style="@style/Tongway.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_checking" />

            <com.tongway.translator.ui.TechProgressView
                android:id="@+id/modelProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/modelProgressText"
                style="@style/Tongway.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnDownload"
                style="@style/Tongway.Pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/model_download" />
        </LinearLayout>

        <!-- 02. Спец. возможности -->
        <LinearLayout
            style="@style/Tongway.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Tongway.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/step_service_title" />

                <TextView
                    style="@style/Tongway.StepNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02" />
            </LinearLayout>

            <TextView
                android:id="@+id/serviceHint"
                style="@style/Tongway.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_service_hint" />

            <TextView
                android:id="@+id/serviceChip"
                style="@style/Tongway.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/btnAccessibility"
                style="@style/Tongway.Pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_accessibility" />

            <TextView
                android:id="@+id/btnAppInfo"
                style="@style/Tongway.Pill.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_app_info" />
        </LinearLayout>

        <!-- 03. Кружок -->
        <LinearLayout
            style="@style/Tongway.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Tongway.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/step_bubble_title" />

                <TextView
                    style="@style/Tongway.StepNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03" />
            </LinearLayout>

            <TextView
                style="@style/Tongway.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_bubble_hint" />

            <TextView
                android:id="@+id/bubbleChip"
                style="@style/Tongway.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnHistory"
                    style="@style/Tongway.Pill.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/menu_history" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/Tongway.Pill.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/menu_settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- Робот показывает, сколько шагов осталось; касание — какие именно. -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/statusRobot"
                android:layout_width="96dp"
                android:layout_height="140dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/robot_scan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusTitle"
                    style="@style/Tongway.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/statusText"
                    style="@style/Tongway.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Tongway.H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_title" />

        <!-- Проверка перевода, на фоне — спираль ДНК со слайда. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:alpha="0.35"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/dna_helix" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Tongway.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/test_hint" />

                <EditText
                    android:id="@+id/testInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="@font/inter"
                    android:gravity="top|start"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:padding="12dp"
                    android:text="@string/test_sample"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnTestTranslate"
                    style="@style/Tongway.Pill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/test_translate" />

                <TextView
                    android:id="@+id/testResult"
                    style="@style/Tongway.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text"
                    android:textIsSelectable="true"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/btnLog"
            style="@style/Tongway.Pill.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/open_log" />

        <!-- Нижняя строка, как на слайдах: точки и номер. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="9dp"
                android:importantForAccessibility="no"
                android:src="@drawable/deco_dash" />

            <ImageView
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/deco_dot" />

            <ImageView
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/deco_dot" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                style="@style/Tongway.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
