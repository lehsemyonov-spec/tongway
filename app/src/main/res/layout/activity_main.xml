<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:textSize="13sp" />

        <!-- Шаг 1: словарь -->
        <TextView
            style="@style/Tongway.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_model_title" />

        <TextView
            style="@style/Tongway.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_model_hint" />

        <TextView
            android:id="@+id/modelStatus"
            style="@style/Tongway.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_checking" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/model_download" />

        <!-- Шаг 2: спец. возможности -->
        <TextView
            style="@style/Tongway.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_service_title" />

        <TextView
            android:id="@+id/serviceStatus"
            style="@style/Tongway.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/serviceHint"
            style="@style/Tongway.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_service_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_accessibility" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppInfo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_app_info" />

        <!-- Шаг 3: кружок -->
        <TextView
            style="@style/Tongway.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step_bubble_title" />

        <TextView
            style="@style/Tongway.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step_bubble_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/bubble_show" />

        <!-- Проверка -->
        <TextView
            style="@style/Tongway.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_title" />

        <TextView
            style="@style/Tongway.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_hint" />

        <EditText
            android:id="@+id/testInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/sample_bg"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="12dp"
            android:text="@string/test_sample" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestTranslate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/test_translate" />

        <TextView
            android:id="@+id/testResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLog"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/open_log" />
    </LinearLayout>
</ScrollView>
