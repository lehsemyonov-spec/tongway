<?xml version="1.0" encoding="utf-8"?>
<!-- Один облачный сервис в настройках: ключ, инструкция, модель, проверка, счётчик. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:background="@drawable/bg_input"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cpTitle"
            style="@style/Tongway.CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cpOrder"
            style="@style/Tongway.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/cpHint"
        style="@style/Tongway.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/keyInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnShowKey"
            style="@style/Tongway.PillSmall.Outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/key_show" />
    </LinearLayout>

    <!-- Кнопки одна под другой: так надписи всегда помещаются в одну строку. -->
    <TextView
        android:id="@+id/btnPasteKey"
        style="@style/Tongway.PillSmall.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:text="@string/key_paste" />

    <TextView
        android:id="@+id/btnKeyHelp"
        style="@style/Tongway.PillSmall.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text="@string/key_help" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/modelText"
            style="@style/Tongway.Hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnModel"
            style="@style/Tongway.PillSmall.Outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/model_choose" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCheckKey"
        style="@style/Tongway.Pill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/key_check" />

    <TextView
        android:id="@+id/checkResult"
        style="@style/Tongway.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text"
        android:visibility="gone" />

    <TextView
        android:id="@+id/usageText"
        style="@style/Tongway.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
