<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Шапка: элементы со слайдов и пара языков. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/deco_burger" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/deco_toggle" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/popupLang"
            style="@style/Tongway.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_ok"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Пока идёт перевод — крутится маленькая ДНК. -->
    <LinearLayout
        android:id="@+id/popupLoader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.tongway.translator.ui.MechanicalDnaView
            android:id="@+id/popupDna"
            android:layout_width="96dp"
            android:layout_height="26dp"
            app:dnaHorizontal="true" />

        <TextView
            android:id="@+id/popupStatus"
            style="@style/Tongway.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />
    </LinearLayout>

    <com.tongway.translator.ui.TechProgressView
        android:id="@+id/popupProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <com.tongway.translator.overlay.MaxHeightScrollView
        android:id="@+id/popupScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/popupTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/text"
                android:textSize="16.5sp" />

            <TextView
                android:id="@+id/popupOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.tongway.translator.overlay.MaxHeightScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/popupBtnCopy"
            style="@style/Tongway.PillSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/popup_copy" />

        <TextView
            android:id="@+id/popupBtnOriginal"
            style="@style/Tongway.PillSmall.Outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/popup_original" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/popupBtnClose"
            style="@style/Tongway.PillSmall.Outline"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/popup_close"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="✕" />
    </LinearLayout>
</LinearLayout>
