<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/popup_bg"
    android:elevation="6dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <com.tongway.translator.overlay.MaxHeightScrollView
        android:id="@+id/popupScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/popupTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/popup_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/popupOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/popup_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.tongway.translator.overlay.MaxHeightScrollView>

    <TextView
        android:id="@+id/popupLang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/popup_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/popupButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/popupBtnOriginal"
            style="@style/Tongway.PopupButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/popup_original" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/popupBtnCopy"
            style="@style/Tongway.PopupButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/popup_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/popupBtnClose"
            style="@style/Tongway.PopupButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/popup_close" />
    </LinearLayout>
</LinearLayout>
